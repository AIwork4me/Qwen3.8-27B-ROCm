# Runtime env for vLLM on gfx1151 (Strix Halo). Sourced by
# scripts/03-serve-vllm.sh. Single source of truth for serve-time env;
# CI-checked by tests/test_serve_args.py.
#
# Env vars intentionally NOT set (all checked against the built tree at vLLM
# 4d2a68d, third_party/vllm):
#   VLLM_USE_V1 — removed upstream: zero references under vllm/ (envs.py
#     included). V1 is the only engine at this commit; exporting it would be
#     dead weight.
#   VLLM_ATTENTION_BACKEND — removed upstream: zero references under vllm/.
#     The supported mechanism at this commit is the CLI flag
#     --attention-backend TRITON_ATTN, pinned in configs/serve-args*.conf
#     (wired from AttentionConfig.backend in vllm/engine/arg_utils.py:964).
#   FLASH_ATTENTION_TRITON_AMD_ENABLE — muse-rocm set this; also removed
#     upstream (zero references at 4d2a68d). Triton attention is selected via
#     the CLI flag instead.

# Triton kernel cache (Triton reads TRITON_CACHE_DIR directly; keep it
# user-local and reuse across server restarts).
export TRITON_CACHE_DIR="${TRITON_CACHE_DIR:-$HOME/.triton/cache}"

# fork + HIP can deadlock in the worker; spawn is the safe default here
# (vllm/envs.py VLLM_WORKER_MULTIPROC_METHOD; validated on this host by the
# muse-rocm reference stack).
export VLLM_WORKER_MULTIPROC_METHOD=spawn

# The model is fetched locally (scripts/02-fetch-model.sh); never hit the
# network at serve time.
export HF_HUB_OFFLINE=1

# Never force a gfx override: the TheRock torch build is gfx1151-native, and an
# inherited HSA_OVERRIDE_GFX_VERSION would silently retarget codegen.
unset HSA_OVERRIDE_GFX_VERSION
